# Copy this file to slicingpie.toml or slicingpie.local.toml and fill in values.
# The token can also come from the GITHUB_TOKEN environment variable (preferred).
# Model multipliers live only in mike-moyer-model.toml (optional overrides below).

mode = "github"

[github]
# Classic token: scopes `repo` and `project` (or `read:project`).
# Fine-grained token: Issues Read + Projects Read on the Project repo/org.
token = ""
# User or organization that owns the Project (not necessarily the repo).
owner = "my-org"
# auto | organization | user
owner_type = "auto"
project_number = 1
# GraphQL API (change only for GitHub Enterprise).
api_url = "https://api.github.com/graphql"

[fields]
# Exact name (case-insensitive) of the Project status field.
status = "Status"
# Values that count as finished. Keep locale aliases your Project uses.
done = ["Done", "Listo", "Completado"]
# Numeric field (or text like "8h") with the estimate. Treated as hours unless
# hours_per_estimate_unit is not 1.
estimate = "Estimate"

[slicing_pie]
# Optional: time_multiplier = 2.0  (default from mike-moyer-model.toml)
default_hourly_rate = 50.0
# If the estimate is in story points, set hours per point here (e.g. 4).
hours_per_estimate_unit = 1.0
# Several assignees: split hours evenly. If false, only the first assignee counts.
split_among_assignees = true

# User list. seniority multiplies rate (1 = no change).
# name is the display name. login must be the GitHub login.
# Fill new users with: make sync-rates
[[users]]
login = "ana"
name = "Ana"
rate = 75
seniority = 1

[[users]]
login = "carlos"
name = "Carlos"
rate = 50
seniority = 1.2

[display]
currency_symbol = "$"
# CLI language. Only "es" is available for now.
language = "es"

[expenses]
label = "[expensa]"
currency = "USD"
# Optional: cash_multiplier = 4.0  (default from mike-moyer-model.toml)
